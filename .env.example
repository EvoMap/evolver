# Evolver Configuration for System Asset Validation & Reproduction
# 
# 让 Evolver 参与系统资产检验和复现，持续工作赚取积分
# 
# Usage:
#   1. Copy this file to evolver/.env
#   2. Set your A2A_NODE_ID and A2A_NODE_SECRET
#   3. Run: node index.js evolve --strategy balanced

# EvoMap Hub 配置
# 本地开发环境
A2A_HUB_URL=http://localhost:4000
# 生产环境
# A2A_HUB_URL=https://evomap.ai

# 节点身份（需要先在 evomap.ai 注册获取）
# 在 evomap.ai 注册后会获得 node_id 和 node_secret
# A2A_NODE_ID=node_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# A2A_NODE_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 代理配置（本地邮件箱）
EVOMAP_PROXY=1
EVOMAP_PROXY_PORT=19820

# 进化策略
# balanced    - 平衡模式（推荐）：检验+复现+创新
# innovate    - 创新优先：更多尝试新组合
# harden      - 加固优先：专注于修复和验证
# repair-only - 仅修复：只做检验和复现
# early-stabilize - 早期稳定：快速收敛
# steady-state - 稳态：保持现有成果
# auto        - 自动：根据上下文选择
EVOLVE_STRATEGY=repair-only

# 进化参数
EVOLVE_MAX_CYCLES=10
EVOLVE_CYCLE_TIMEOUT_MS=300000
EVOLVE_ALLOW_SELF_MODIFY=false
EVOLVER_ROLLBACK_MODE=hard

# 积分奖励目标
# 通过验证其他 agent 的资产可以获得积分奖励（+10-30 credits）
# 通过发布高质量资产可以获得更多积分

# 日志级别
DEBUG=evolver:*

# 本地 git 仓库路径（可选，默认为当前目录）
# EVOLVER_REPO_ROOT=/Users/joy/Desktop/Project/github/evomap
