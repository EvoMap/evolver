{
  "name": "@evomap/evolver-cli",
  "version": "2.0.0-beta.3",
  "private": false,
  "type": "module",
  "description": "evolver CLI (status/watch/cycles/rebuild-views/...)",
  "bin": {
    "evolver": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dispatch": {
      "types": "./dist/dispatch.d.ts",
      "default": "./dist/dispatch.js"
    }
  },
  "dependencies": {
    "@evomap/evolver-core": "2.0.0-beta.3",
    "@evomap/evolver-adapter-public": "2.0.0-beta.3",
    "@evomap/evolver-mcp": "2.0.0-beta.3",
    "@evomap/evolver-proxy": "2.0.0-beta.3",
    "@evomap/evolver-runtime-adapters": "2.0.0-beta.3",
    "@evomap/evolver-webui": "2.0.0-beta.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvoMap/evolver-v2-private-dev.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "v2-beta"
  },
  "files": [
    "dist/",
    "assets/",
    "README.md",
    "package.json"
  ]
}
