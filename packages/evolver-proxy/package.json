{
  "name": "@evomap/evolver-proxy",
  "version": "2.0.0-beta.12",
  "private": false,
  "type": "module",
  "description": "系统级 mailbox/hub 同步 daemon (Node)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "evolver-llm-proxy": "./dist/bin/evolver-llm-proxy.js",
    "evolver-proxy": "./dist/bin/evolver-proxy.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bin/evolver-proxy": {
      "types": "./dist/bin/evolver-proxy.d.ts",
      "default": "./dist/bin/evolver-proxy.js"
    },
    "./bin/evolver-llm-proxy": {
      "types": "./dist/bin/evolver-llm-proxy.d.ts",
      "default": "./dist/bin/evolver-llm-proxy.js"
    }
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1053.0",
    "@evomap/evolver-adapter-public": "2.0.0-beta.12",
    "@evomap/evolver-core": "2.0.0-beta.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvoMap/evolver.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "v2-beta"
  },
  "files": [
    "dist/",
    "assets/",
    "README.md",
    "package.json"
  ]
}
