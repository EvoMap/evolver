{
  "name": "@evomap/evolver-mcp",
  "version": "2.0.0-beta.23",
  "private": false,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "description": "Evolver MCP server (agent 工具发现入口)",
  "bin": {
    "evolver-mcp": "./dist/stdio.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "default": "./dist/stdio.js"
    },
    "./product-bridge": {
      "types": "./dist/productBridgeShim.d.ts",
      "default": "./dist/productBridgeShim.js"
    }
  },
  "dependencies": {
    "@evomap/evolver-core": "2.0.0-beta.23",
    "smol-toml": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvoMap/evolver.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "v2-beta"
  },
  "files": [
    "dist/",
    "assets/",
    "README.md",
    "package.json"
  ]
}
