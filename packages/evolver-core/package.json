{
  "name": "@evomap/evolver-core",
  "version": "2.0.48",
  "private": false,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "description": "hub-无关核心: 算法引擎/原材料/mailbox/资产库/workflow",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v1-env-compat": {
      "types": "./dist/bootstrap/v1EnvCompat.d.ts",
      "default": "./dist/bootstrap/v1EnvCompat.js"
    },
    "./prompt-recall": {
      "types": "./dist/promptRecall.d.ts",
      "default": "./dist/promptRecall.js"
    },
    "./experience": {
      "types": "./dist/experience.d.ts",
      "default": "./dist/experience.js"
    },
    "./snapshot-worker": {
      "types": "./dist/assetstore/snapshotWorkerBridge.d.ts",
      "default": "./dist/assetstore/snapshotWorkerBridge.js"
    },
    "./protected-audit-service": {
      "types": "./dist/events/protectedAuditServiceMain.d.ts",
      "default": "./dist/events/protectedAuditServiceMain.js"
    },
    "./protected-audit-rpc-child": {
      "types": "./dist/events/protectedAuditRpcChild.d.ts",
      "default": "./dist/events/protectedAuditRpcChild.js"
    },
    "./protected-audit-migration": {
      "types": "./dist/events/protectedAuditMigration.d.ts",
      "default": "./dist/events/protectedAuditMigration.js"
    }
  },
  "dependencies": {
    "@evomap/gep-sdk": "1.14.0",
    "ajv": "^8.20.0",
    "koffi": "3.2.1",
    "ulid": "^2.3.0",
    "zod": "^4.6.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EvoMap/evolver.git"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "files": [
    "dist/",
    "assets/",
    "README.md",
    "package.json"
  ]
}
